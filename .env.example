RAVEN_API_KEY=change-me-to-a-long-random-secret
POSTGRES_DB=raven
POSTGRES_USER=raven
POSTGRES_PASSWORD=change-me-to-a-long-random-database-password
MINIO_ROOT_USER=raven-local
MINIO_ROOT_PASSWORD=change-me-to-a-long-random-object-storage-password
RAVEN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RAVEN_BROWSER_API_URL=http://localhost:8000
RAVEN_API_BIND=127.0.0.1
RAVEN_FRONTEND_BIND=127.0.0.1
RAVEN_MINIO_BIND=127.0.0.1
RAVEN_PROMETHEUS_BIND=127.0.0.1
RAVEN_WORKER_CONCURRENCY=1
RAVEN_THERMAL_FACE_LANDMARKS=0
# Optional paper-aligned two-confidence-input calibration checkpoint.
RAVEN_CONFIDENCE_FUSION_WEIGHTS=data/models/confidence_fusion.pt
RAVEN_DECODE_QUEUE_SIZE=8
# Optional: leave unset until you have a video-trained checkpoint.
# RAVEN_ACTION_MODEL_WEIGHTS=data/models/action_anomaly.pt
